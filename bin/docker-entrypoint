#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name "libjemalloc.so*" 2>/dev/null | head -1)
    export LD_PRELOAD
fi

# If running the rails server then create or migrate existing database
if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
    if [ -n "${BUCKET_NAME}" ]; then
        litestream restore -config /rails/config/litestream.yml -if-db-not-exists -if-replica-exists /rails/storage/production.sqlite3
    fi

    ./bin/rails db:prepare

    if [ -n "${BUCKET_NAME}" ]; then
        exec litestream replicate -config /rails/config/litestream.yml -exec "${*}"
    fi
fi

exec "${@}"
