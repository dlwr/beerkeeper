#!/bin/bash
set -euo pipefail
cd /home/user/beerkeeper

v=$(cat .ruby-version)
. /etc/os-release
arch=$([ "$(uname -m)" = aarch64 ] && echo arm64 || echo x64)
dir=/opt/hostedtoolcache/Ruby/$v
if [ ! -x "$dir/$arch/bin/ruby" ]; then
  mkdir -p "$dir"
  curl -fsSL "https://github.com/ruby/ruby-builder/releases/download/ruby-$v/ruby-$v-ubuntu-$VERSION_ID-$arch.tar.gz" | tar xz -C "$dir" \
    || { RBENV_ROOT=/opt/rbenv /opt/rbenv/bin/rbenv install -s "$v" && ln -sfn "/opt/rbenv/versions/$v" "$dir/$arch"; }
fi
echo "export PATH=$dir/$arch/bin:\$PATH" > /etc/profile.d/ruby.sh
grep -qs profile.d/ruby.sh ~/.bashrc || echo '. /etc/profile.d/ruby.sh' >> ~/.bashrc
export PATH=$dir/$arch/bin:$PATH

# node22 の古い chromedriver を拾うと Chrome と版が合わず system spec が落ちる
[ -e /opt/node22/bin/chromedriver ] && mv /opt/node22/bin/chromedriver /opt/node22/bin/chromedriver.old

bundle install -j4
RAILS_ENV=test bin/rails db:setup
