class User < ApplicationRecord
  def self.find_by_email: (String? email) -> User?
  def self.find_by_password_reset_token: (String token) -> User?

  def email: () -> String?
  def password: () -> String?
  def password_confirmation: () -> String?
  def password_reset_token: () -> String?
  def email=: (String email) -> void
  def password=: (String password) -> void
  def password_confirmation=: (String password_confirmation) -> void
  def authenticate: (String password) -> (User | false | nil)
  def participatable?: (Event event) -> bool

  private

  def credential: () -> User::PasswordCredential
  def password_credential_must_be_valid: () -> void
end
