<% labels = { "start_at" => "開始日時", "end_at" => "終了日時", "location" => "開催場所" } %>
<% format = ->(value) { value.respond_to?(:strftime) ? l(value) : value.presence || "未定" } %>
<!DOCTYPE html>
<html>
  <body style="font-family: Arial, sans-serif; line-height: 1.6;">
    <p><%= @user.name %> 様</p>

    <p>
      「<strong><%= @event.name %></strong>」の開催日時・場所が変更されました。
    </p>

    <hr>

    <p>
      <% @changes.each do |attribute, (before, after)| %>
        <strong><%= labels[attribute] %>：</strong><%= format.(before) %> → <%= format.(after) %><br>
      <% end %>
    </p>

    <p>
      詳細はこちらからご確認いただけます：<br>
      <a href="<%= event_url(@event) %>"><%= event_url(@event) %></a>
    </p>

    <hr>

    <p>
      ───────────────<br>
      Beerkeeper運営チーム
    </p>
  </body>
</html>
