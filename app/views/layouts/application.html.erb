<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>Beerkeeper</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <%= favicon_link_tag('favicon.ico') %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <%= link_to root_path, class: "site-header__logo" do %>
          <%= image_tag "logo.svg", alt: "Beerkeeper トップへ", width: 160, height: 39 %>
        <% end %>
        <nav aria-label="メイン">
          <ul class="site-nav">
            <% if current_user %>
              <li>
                <%= link_to user_path, class: "btn btn-outline-secondary" do %>
                  <% if current_user.avatar_url %>
                    <%= image_tag current_user.avatar_url, alt: "", width: 24, height: 24, class: "avatar" %>
                  <% end %>
                  マイページ
                <% end %>
              </li>
              <li>
                <%= link_to "ログアウト", session_path(current_user), data: { turbo_method: :delete }, class: "btn btn-outline-secondary" %>
              </li>
            <% elsif !current_page?(login_path) %>
              <li>
                <%= link_to "ログイン", login_path(return_to: (request.fullpath if request.get?)), class: "btn btn-outline-secondary" %>
              </li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="container site-main" tabindex="-1">
      <% flash.each do |message_type, message| %>
        <%= render(AlertComponent.new(message_type: message_type, message: message)) %>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
