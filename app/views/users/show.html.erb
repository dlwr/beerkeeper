<h1>マイページ</h1>

<%= render(UserComponent.new(user: @user)) %>

<h2 class="section-heading">参加予定のイベント</h2>
<% if @participations.any? %>
  <ul class="event-rows">
    <% @participations.each do |participation| %>
      <%= render "event_row", event: participation.event, waitlisted: participation.waitlisted? %>
    <% end %>
  </ul>
<% else %>
  <p class="text-body-secondary">参加予定のイベントはありません。</p>
<% end %>

<h2 class="section-heading">主催するイベント</h2>
<% if @organizing_events.any? %>
  <ul class="event-rows">
    <% @organizing_events.each do |event| %>
      <%= render "event_row", event: %>
    <% end %>
  </ul>
<% else %>
  <p class="text-body-secondary">主催するイベントはありません。</p>
<% end %>

<h2 class="section-heading">主催したイベント</h2>
<% if @organized_events.any? %>
  <ul class="event-rows">
    <% @organized_events.each do |event| %>
      <%= render "event_row", event: %>
    <% end %>
  </ul>
<% else %>
  <p class="text-body-secondary">主催したイベントはありません。</p>
<% end %>

<h2 class="section-heading">参加したイベント</h2>
<% if @attended_participations.any? %>
  <ul class="event-rows">
    <% @attended_participations.each do |participation| %>
      <%= render "event_row", event: participation.event %>
    <% end %>
  </ul>
<% else %>
  <p class="text-body-secondary">参加したイベントはありません。</p>
<% end %>
