<li>
  <%= link_to event, class: "event-row" do %>
    <span class="event-row__name"><%= event.name %></span>
    <span class="event-row__when">
      <span><%= event_date_label(event) %></span>
      <span><%= event_time_range(event) %></span>
      <% if !event.cancelled? && (timing = event_timing_label(event)) %>
        <span class="seat-status"><%= timing %></span>
      <% end %>
    </span>
    <% if event.cancelled? %>
      <span class="seat-status seat-status--full">中止</span>
    <% elsif local_assigns[:waitlisted] %>
      <span class="seat-status">補欠</span>
    <% end %>
    <% if local_assigns[:seats] && !event.cancelled? %>
      <span class="event-row__seats">
        <span><%= participant_count_label(event) %></span>
        <% unless event.max_size.nil? %>
          <span class="seat-status<%= " seat-status--full" if seats_full?(event) %>"><%= seats_status(event) %></span>
        <% end %>
      </span>
    <% end %>
    <% if event.location.present? %>
      <span class="event-row__where"><%= event.location %></span>
    <% end %>
  <% end %>
</li>
