<ul class="event-list">
  <% events.each do |event| %>
    <li>
      <%= link_to event, class: ["event-item", ("event-item--past" if event.ended?), ("event-item--full" if seats_full?(event))] do %>
        <%= content_tag local_assigns.fetch(:heading, :h3), event.name, class: "event-item__name" %>
        <p class="event-item__when">
          <span><%= event_date_label(event) %></span>
          <span><%= event_time_range(event) %></span>
          <% if (timing = event_timing_label(event)) %>
            <span class="seat-status"><%= timing %></span>
          <% end %>
        </p>
        <% if event.location.present? %>
          <p class="event-item__where"><%= event.location %></p>
        <% end %>
        <p class="event-item__seats">
          <span class="event-item__status"><%= seats_status(event) %></span>
          <span class="event-item__count"><%= participant_count_label(event) %></span>
          <% if participation_states.key?(event.id) %>
            <span class="seat-status event-item__mine"><%= participation_states[event.id] ? "補欠" : "参加予定" %></span>
          <% end %>
        </p>
      <% end %>
    </li>
  <% end %>
</ul>
