<%= form_with model: @event, class: "event-form" do |form| %>
  <div class="form-group">
    <%= form.label :name, class: "form-label" do %>イベント名 <span class="field-tag">必須</span><% end %>
    <%= form.text_field :name, class: "form-control", required: true, **field_error_attributes(@event, :name) %>
    <%= field_error(@event, :name) %>
  </div>

  <% [[:start_at, "開始", "event-start"], [:end_at, "終了", "event-end"]].each do |attribute, label, klass| %>
    <% date_optional = attribute == :end_at %>
    <% date_hint_id = "event_#{attribute}_date_hint" if date_optional %>
    <% error_attributes = field_error_attributes(@event, attribute) %>
    <fieldset class="form-group <%= klass %>">
      <legend><%= label %>日時<% unless date_optional %> <span class="field-tag">必須</span><% end %></legend>
      <div class="datetime-fields">
        <div>
          <%= form.label "#{attribute}_date", class: "form-label" do %>日付<% if date_optional %> <span class="field-tag field-tag--optional">任意</span><% end %><% end %>
          <%= form.date_field attribute,
              name: "event[#{attribute}_date]",
              id: "event_#{attribute}_date",
              value: @event.public_send("#{attribute}_date").presence || @event.public_send(attribute)&.to_date,
              required: !date_optional,
              class: "form-control",
              aria: { invalid: error_attributes.dig(:aria, :invalid), describedby: [ date_hint_id, error_attributes.dig(:aria, :describedby) ].compact.join(" ").presence } %>
        </div>
        <div>
          <%= form.label "#{attribute}_time", class: "form-label" do %>時刻<% if date_optional %> <span class="field-tag">必須</span><% end %><% end %>
          <%= form.time_field attribute,
              name: "event[#{attribute}_time]",
              id: "event_#{attribute}_time",
              value: @event.public_send("#{attribute}_time").presence || @event.public_send(attribute)&.strftime("%H:%M"),
              required: true,
              class: "form-control",
              **error_attributes %>
        </div>
      </div>
      <% if date_optional %>
        <p class="form-hint" id="<%= date_hint_id %>">空なら開始と同じ日</p>
      <% end %>
      <%= field_error(@event, attribute) %>
    </fieldset>
  <% end %>

  <div class="form-group">
    <%= form.label :location, class: "form-label" do %>開催場所 <span class="field-tag field-tag--optional">任意</span><% end %>
    <%= form.text_field :location, class: "form-control", **field_error_attributes(@event, :location) %>
    <%= field_error(@event, :location) %>
  </div>

  <div class="form-group">
    <%= form.label :max_size, class: "form-label" do %>定員 <span class="field-tag field-tag--optional">任意</span><% end %>
    <%= form.number_field :max_size, class: "form-control form-control--short", inputmode: "numeric", min: 1, step: 1, **field_error_attributes(@event, :max_size) %>
    <p class="form-hint">空なら定員なし</p>
    <%= field_error(@event, :max_size) %>
  </div>

  <div class="form-group">
    <%= form.label :budget, class: "form-label" do %>参加費 <span class="field-tag field-tag--optional">任意</span><% end %>
    <%= form.text_field :budget, class: "form-control", **field_error_attributes(@event, :budget) %>
    <p class="form-hint">数字だけなら「円」を付けて表示します。空なら「未定」</p>
    <%= field_error(@event, :budget) %>
  </div>

  <div class="form-group">
    <%= form.label :description, class: "form-label" do %>詳細 <span class="field-tag field-tag--optional">任意</span><% end %>
    <%= form.text_area :description, class: "form-control", rows: 5, **field_error_attributes(@event, :description) %>
    <%= field_error(@event, :description) %>
  </div>

  <div class="form-group">
    <%= form.label :participant_notice, class: "form-label" do %>参加者へのお知らせ <span class="field-tag field-tag--optional">任意</span><% end %>
    <%= form.text_area :participant_notice, class: "form-control", rows: 3, **field_error_attributes(@event, :participant_notice) %>
    <p class="form-hint">集合場所や持ち物など。主催者と参加者にだけ見せます</p>
    <%= field_error(@event, :participant_notice) %>
  </div>

  <div class="form-actions">
    <%= form.submit "保存", class: "btn btn-primary" %>
    <%= link_to "キャンセル", (@event.persisted? ? event_path(@event) : root_path), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
