<h1><%= @event.name %></h1>

<% if @event.cancelled? %>
  <div class="alert alert-danger">
    <p class="mb-0">このイベントは中止されました</p>
    <% if @event.cancellation.reason.present? %>
      <p class="mb-0">中止理由: <%= text_with_links(@event.cancellation.reason) %></p>
    <% end %>
  </div>
<% end %>

<% if @event.ended? && !@event.cancelled? %>
  <div class="alert alert-secondary">このイベントは終了しました</div>
<% end %>

<% if @event.participant_notice_visible_to?(current_user) %>
  <div class="alert alert-info">
    <h2 class="h6">参加者へのお知らせ</h2>
    <%= format_with_links @event.participant_notice, class: "mb-0" %>
  </div>
<% end %>

<dl class="event-facts">
  <div>
    <dt>日時</dt>
    <dd>
      <span><%= event_date_label(@event) %></span>
      <span><%= event_time_range(@event) %></span>
    </dd>
  </div>
  <div>
    <dt>場所</dt>
    <dd><%= @event.location.present? ? text_with_links(@event.location) : "未定" %></dd>
  </div>
  <div>
    <dt>参加人数</dt>
    <dd>
      <span><%= participant_count_label(@event) %></span>
      <% unless @event.cancelled? || @event.max_size.nil? %>
        <span class="seat-status<%= ' seat-status--full' if seats_full?(@event) %>"><%= seats_status(@event) %></span>
      <% end %>
    </dd>
  </div>
  <div>
    <dt>参加費</dt>
    <dd><%= budget_label(@event) %></dd>
  </div>
  <div>
    <dt>主催者</dt>
    <dd><%= @event.organizer.name %></dd>
  </div>
</dl>

<% unless @event.cancelled? || @event.ended? %>
  <div class="event-action">
    <% if current_user.nil? %>
      <%= link_to "Discord でログインして参加する", login_path(return_to: event_path(@event)), class: "btn btn-primary btn-lg" %>
    <% elsif current_user.participatable?(@event) %>
      <% if @event.full? %>
        <p class="event-action__note">満席のため補欠で申し込みます</p>
      <% end %>
      <%= button_to "参加する", event_participations_path(@event), class: "btn btn-primary btn-lg", form_class: "event-action__form" %>
    <% elsif (participation = current_user.participations.find_by(event: @event)) %>
      <p class="event-action__note">
        <% if participation.waitlisted? %>
          あなたは補欠の<%= @event.waitlist_position(current_user) %>番目です
        <% else %>
          参加予定です
        <% end %>
      </p>
      <%= button_to "参加をキャンセルする", event_participation_path(@event, participation), method: :delete, class: "btn btn-outline-secondary", form_class: "event-action__form", form: { data: { turbo_confirm: "参加をキャンセルしてよろしいですか?" } } %>
    <% end %>
  </div>
<% end %>

<p class="mt-4">
  <%= link_to "カレンダーに追加", event_path(@event, format: :ics), class: "btn btn-outline-secondary" %>
</p>

<% if @event.description.present? %>
  <h2 class="section-heading">詳細</h2>
  <%= format_with_links @event.description %>
<% end %>

<h2 class="section-heading">参加者リスト</h2>
<% if @event.participants.present? %>
  <ul class="name-list">
    <% @event.participants.each do |participant| %>
      <li><%= participant.name %></li>
    <% end %>
  </ul>
<% else %>
  <p class="text-body-secondary">参加者なし</p>
<% end %>

<% if @event.waitlisters.present? %>
  <h2 class="section-heading">補欠リスト</h2>
  <ol class="name-list">
    <% @event.waitlisters.each do |waitlister| %>
      <li><%= waitlister.name %></li>
    <% end %>
  </ol>
<% end %>

<% if @event.organized_by?(current_user) %>
  <section class="organizer-actions" aria-labelledby="organizer-actions-heading">
    <h2 id="organizer-actions-heading">主催者向けの操作</h2>
    <div class="organizer-actions__links">
      <% unless @event.cancelled? %>
        <%= link_to "編集", edit_event_path(@event), class: "btn btn-outline-secondary" %>
      <% end %>
      <%= link_to "このイベントをもとに作成", new_event_path(source_id: @event.id), class: "btn btn-outline-secondary" %>
    </div>
    <% unless @event.cancelled? %>
      <%= form_with url: event_cancellations_path(@event), scope: :cancellation, class: "organizer-actions__danger", data: { turbo_confirm: "本当に中止にしてよろしいですか?" } do |f| %>
        <h3>イベントを中止する</h3>
        <p>中止すると参加者に知らせます。取り消せません。</p>
        <%= f.label :reason, "中止理由（任意）", class: "form-label" %>
        <%= f.text_field :reason, class: "form-control mb-3" %>
        <%= f.submit "イベント中止", class: "btn btn-outline-danger" %>
      <% end %>
    <% end %>
  </section>
<% end %>

<p class="mt-5"><%= link_to "トップへ戻る", root_path, class: "back-link" %></p>
