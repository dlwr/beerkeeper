<h1><%= @event.name %></h1>

<% if @event.cancelled? %>
  <div class="alert alert-danger">
    <p class="mb-0">このイベントは中止されました</p>
    <% if @event.cancellation.reason.present? %>
      <p class="mb-0">中止理由: <%= @event.cancellation.reason %></p>
    <% end %>
  </div>
<% end %>

<ul class="list-group">
  <li class="list-group-item">
    開始日時: <%= l(@event.start_at) %>
  </li>
  <li class="list-group-item">
    終了日時: <%= l(@event.end_at) %>
  </li>
  <li class="list-group-item">
    開催場所: <%= @event.location %>
  </li>
  <li class="list-group-item">
    主催者: <%= @event.organizer.name %>
  </li>
  <li class="list-group-item">
    参加人数: <%= @event.participants.size %>人 / <%= @event.max_size %>人
  </li>
  <li class="list-group-item">
    参加費: <%= @event.budget %>円
  </li>
  <li class="list-group-item">
    詳細:<br>
    <%= simple_format @event.description %>
  </li>

  <% if @event.cancelled? %>
  <% elsif current_user && current_user.participatable?(@event) %>
    <li class="list-group-item">
      <%= button_to '参加する', event_participations_path(@event) %>
    </li>
  <% elsif (participation = current_user&.participations&.find_by(event: @event)) %>
    <li class="list-group-item">
      <%= button_to '参加をキャンセルする', event_participation_path(@event, participation), method: :delete, form: { data: { turbo_confirm: "参加をキャンセルしてよろしいですか?" } } %>
    </li>
  <% end %>
</ul>

<% if @event.participants.present? %>
  参加者リスト
  <ul class="list-group">
    <% @event.participants.each do |participant| %>
      <li class="list-group-item"><%= participant.name %></li>
    <% end %>
  </ul>
<% else %>
  参加者なし
<% end %>

<% if @event.organizer?(current_user) && !@event.cancelled? %>
  <div><%= link_to '編集', edit_event_path(@event) %></div>
  <%= form_with url: event_cancellations_path(@event), scope: :cancellation, data: { turbo_confirm: "本当に中止にしてよろしいですか?" } do |f| %>
    <%= f.label :reason, "中止理由" %>
    <%= f.text_field :reason %>
    <%= f.submit "イベント中止" %>
  <% end %>
<% end %>
<div><%= link_to 'トップへ戻る', root_path %></div>
