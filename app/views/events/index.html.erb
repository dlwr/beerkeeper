<% page_title "イベント一覧" %>
<div class="page-heading">
  <h1>イベント一覧</h1>
  <% if current_user %>
    <%= link_to "イベントを作成", new_event_path, class: "btn btn-primary" %>
  <% end %>
</div>

<section aria-labelledby="upcoming-heading">
  <h2 id="upcoming-heading" class="section-heading">開催予定</h2>
  <% if @upcoming_events.any? %>
    <%= render "list", events: @upcoming_events, participation_states: @participation_states %>
  <% else %>
    <p class="text-body-secondary">開催予定のイベントはありません。</p>
  <% end %>
</section>

<section aria-labelledby="past-heading">
  <h2 id="past-heading" class="section-heading">過去のイベント</h2>
  <% if @past_events.any? %>
    <%= render "list", events: @past_events, participation_states: @participation_states %>
    <% if @more_past_events %>
      <%= link_to "過去のイベントをすべて見る", past_events_path, class: "more-link" %>
    <% end %>
  <% else %>
    <p class="text-body-secondary">過去のイベントはありません。</p>
  <% end %>
</section>
